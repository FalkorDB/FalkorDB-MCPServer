# Environment Configuration
NODE_ENV=development

# MCP Transport Configuration
# Transport mode: 'http' (Streamable HTTP) or 'stdio'. The app falls back to
# 'stdio' when MCP_TRANSPORT is unset; this sample and the Docker image use 'http'.
MCP_TRANSPORT=http

# Port for HTTP transport. Defaults to 8080 when unset.
# MCP_PORT=8080

# Docker Compose: host-side bind address for the MCP server's published port.
# - Every deployment (Compose or not) evaluates this in the HTTP startup guard:
#   a non-loopback value with MCP_API_KEY unset refuses to start the server.
# - Outside Docker Compose, it does NOT change what interface the Node process
#   itself listens on (that's always every interface) — the startup guard
#   above is this variable's only effect there. See #192.
# - MCP clients must include the header `Authorization: Bearer <key>` when MCP_API_KEY is set.
# - HTTP transport has no TLS support: reaching this over anything but loopback
#   sends that header in cleartext. Put a TLS-terminating reverse proxy in
#   front for remote access.
# MCP_BIND_ADDRESS=127.0.0.1
# MCP_API_KEY=your_mcp_api_key_here

# FalkorDB Configuration
# When using Docker Compose, set FALKORDB_HOST=falkordb (the service name)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_WEB_PORT=3000
# Docker Compose only: interface the bundled web UI's published port binds to.
# - The UI has no auth of its own — only set this to 0.0.0.0 on a trusted network.
# FALKORDB_WEB_BIND_ADDRESS=127.0.0.1
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Set to 'true' to use read-only queries by default (useful for replica instances)
FALKORDB_DEFAULT_READONLY=false
# Set to 'true' to enforce strict read-only mode - blocks all write operations (queries, graph deletions, key modifications)
FALKORDB_STRICT_READONLY=false

# Logging Configuration (optional)
ENABLE_FILE_LOGGING=false
